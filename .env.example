# Public HTTPS URL of this app (your Coolify domain). Used for the Hackatime OAuth redirect:
#   ${PUBLIC_URL}/oauth/callback
PUBLIC_URL=https://goblin.example.com
PORT=3000

# Slack app (api.slack.com/apps > your app)
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...

# Hackatime OAuth app (hackatime.hackclub.com/oauth/applications)
HACKATIME_CLIENT_ID=...
HACKATIME_CLIENT_SECRET=...
# HACKATIME_BASE_URL=https://hackatime.hackclub.com

# 32 random bytes, base64. Encrypts Hackatime tokens at rest. Generate with: openssl rand -base64 32
# Changing it later means everyone has to reconnect Hackatime.
ENCRYPTION_KEY=

# SQLite file. In Docker/Coolify keep it on the persistent volume.
DATABASE_PATH=/data/goblin.sqlite

# Optional: only these Slack user ids can use the goblin (comma separated). Empty = everyone.
ALLOWED_SLACK_IDS=

# Optional: log DMs instead of sending them.
DRY_RUN=false
LOG_LEVEL=info
